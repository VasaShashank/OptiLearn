# Copy to backend/.env and adjust. Every value is optional; defaults shown.

# Primary relational database (PostgreSQL). The API connects as the least-privilege
# optiteach_app role, which migration 0003 creates with the password given here.
# If unreachable, the app falls back to SQLite at backend/optiteach.db
# (no views/triggers/procedures/RLS there).
DATABASE_URL=postgresql://optiteach_app:optiteach_app_dev@localhost:5432/optiteach

# Schema owner used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optiteach

# Document store. Use "mongomock://" to force the in-memory engine.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=optiteach_artifacts

# JWT signing key — change this for any shared deployment.
SECRET_KEY=change-me
