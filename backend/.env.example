# Copy to backend/.env and adjust. Every value is optional; defaults shown.

# Primary relational database (PostgreSQL). If unreachable, the app falls back
# to SQLite at backend/optiteach.db (no views/triggers/procedures there).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optiteach

# Document store. Use "mongomock://" to force the in-memory engine.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=optiteach_artifacts

# JWT signing key — change this for any shared deployment.
SECRET_KEY=change-me
